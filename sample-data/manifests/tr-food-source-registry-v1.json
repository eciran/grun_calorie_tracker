    "storePolicy": {
      "exactTurkeySpecific": ["carrefoursa", "a101", "bim", "sok", "macrocenter"],
      "ambiguousRequiresIndependentEvidence": ["migros", "metro"]
    },
    "signals": [
      {
        "id": "OFF_COUNTRY_TR",
        "score": 80,
        "strong": true,
        "description": "OFF country tags explicitly include Turkey/Turkiye."
      },
      {
        "id": "TR_RETAILER_TAG",
        "score": 50,
        "strong": true,
        "description": "OFF store tags exactly match a configured Turkey-specific retailer. Ambiguous international chains such as Migros and Metro are excluded unless independent TR evidence exists."
      },
      {
        "id": "TR_LOCALIZED_CONTENT",
        "score": 25,
        "strong": false,
        "description": "A Turkish product, generic or ingredients field is present."
      },
      {
        "id": "TR_PRIMARY_LANGUAGE",
        "score": 15,
        "strong": false,
        "description": "The OFF primary language code is tr."
      },
      {
        "id": "GS1_TR_PREFIX",
        "score": 10,
        "strong": false,
        "description": "GTIN starts with 868/869; this never proves market or origin by itself."
      }
    ],
    "strictRequires": "qualityPass && score >= 80 && (OFF_COUNTRY_TR || (TR_RETAILER_TAG && TR_LOCALIZED_CONTENT))",
    "reviewRequires": "qualityPass && score >= 40",
    "quarantineRequires": "!qualityPass || score < 40"
  },
  "qualityGate": {
    "validGtinCheckDigit": true,
    "requireName": true,
    "requireBrand": true,
    "requireCalories": true,
